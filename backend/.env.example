# Copy this file to .env locally and replace every CHANGE_ME value.
# Never commit backend/.env. Use your VPS secret manager or deployment environment in production.

# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Local demo access — localhost development only. This is intentionally not Better Auth.
# Generate a unique 32+ character value locally; never use it in beta/production.
# When present, BETTER_AUTH_SECRET may be used temporarily until Better Auth replaces this shortcut.
LOCAL_DEMO_ACCESS_ENABLED=false
LOCAL_DEMO_EMAIL=you@example.com
LOCAL_DEMO_SESSION_SECRET=CHANGE_ME_LOCAL_32_CHARACTER_MINIMUM_SECRET


# Supabase PostgreSQL (server-only connection string; do not expose it to the frontend)
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres?sslmode=require

# Better Auth
# Generate a long random value and use a different value in every environment.
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000

# Email is required when email verification and password recovery are implemented.
EMAIL_FROM=App Doctor <no-reply@example.com>
EMAIL_PROVIDER_API_KEY=CHANGE_ME

# Redis / BullMQ — self-hosted on the production VPS, not a managed Redis service.
# Keep Redis bound to 127.0.0.1 or a private Docker/VPS network; never expose port 6379 publicly.
# The password below is required in production. Local development may use a separate local value.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379
REDIS_QUEUE_PREFIX=app-doctor

# Redis RAM is controlled in the VPS Redis configuration, not by this application variable:
#   maxmemory 256mb
#   maxmemory-policy noeviction
# Also enable persistence appropriate for queued jobs (for example, AOF) and monitor memory usage.
# Choose the actual maxmemory after measuring VPS capacity; 256 MB is a conservative starting point.

# Private AWS S3 artifact storage (screenshots, traces, and approved evidence only)
# Keep the bucket private, leave S3 Block Public Access enabled, and use short-lived presigned URLs.
AWS_REGION=eu-west-1
S3_BUCKET=app-doctor-artifacts-development
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_ARTIFACT_PREFIX=artifacts
S3_PRESIGNED_URL_TTL_SECONDS=300

# Encrypt credentials and other sensitive values before persisting them.
# Store/rotate this production value in a secrets manager, not in the repository.
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# OpenAI AI diagnostics — server only. Never expose OPENAI_API_KEY in frontend variables.
# Leave disabled until Phase 7; choose the model during implementation based on the
# approved quality, latency, and cost target.
OPENAI_DIAGNOSTICS_ENABLED=false
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=60000

# Worker safety limits — start conservatively on the VPS and raise only after measurement.
PLAYWRIGHT_WORKER_CONCURRENCY=1
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_RUN_TIMEOUT_MS=180000
PLAYWRIGHT_MAX_REDIRECTS=5
