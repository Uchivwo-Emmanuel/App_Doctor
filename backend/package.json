{
  "name": "app-doctor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx src/db/check-connection.ts",
    "db:seed:local-demo": "tsx src/db/seed-local-demo.ts",
    "worker:scan": "tsx src/workers/scan-worker.ts",
    "playwright:install": "playwright install chromium",
    "redis:start": "node -r dotenv/config scripts/start-local-redis.cjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.7.10",
    "bullmq": "^6.3.15",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.5"
  }
}
