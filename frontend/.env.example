# Public values only. Everything beginning with VITE_ is bundled into the browser.
# Never put database URLs, Redis credentials, AWS keys, Better Auth secrets, or AI keys here.

# Express/tRPC API origin, without a trailing slash.
VITE_API_URL=http://localhost:3000

# Public application identity.
VITE_APP_NAME=App Doctor

# Local development only. Production values must use the deployed HTTPS frontend URL.
VITE_APP_ENV=development
